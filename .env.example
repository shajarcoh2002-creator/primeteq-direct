# Admin panel password (/admin). Use a long random value in production.
ADMIN_PASSWORD=change-me

# Postgres connection string (Neon, Supabase, Vercel Postgres…).
# Leave empty locally to store data in ./data/*.json instead. Required on Vercel.
DATABASE_URL=

# Outgoing email (order confirmations and shipping labels), sent through your Google Workspace mailbox.
# SMTP_PASS is a Google "app password" (16 characters), not your normal password.
SMTP_USER=sales@primeteqdirect.com
SMTP_PASS=
# Optional: public site address used in email links (defaults to the Vercel production URL).
SITE_URL=

# WhatsApp alert to the manager on every new order (WhatsApp Cloud API, Meta). See src/lib/whatsapp.ts.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: manager number(s), international format without +, comma-separated (default 50767472722).
WHATSAPP_NOTIFY_TO=50767472722
# Approved message template name and its language code.
WHATSAPP_TEMPLATE=nueva_orden
WHATSAPP_TEMPLATE_LANG=es
